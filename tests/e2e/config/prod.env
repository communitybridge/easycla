#
# Non-secret configuration for the PROD E2E run. Parsed as KEY=VALUE lines (never sourced).
# Secrets (passwords, tokens, client ids) live in tests/e2e/secrets/*.secret - see secrets/README.md.

E2E_ENV=prod

# ---- endpoints -------------------------------------------------------------
API_GW=https://api-gw.platform.linuxfoundation.org
API_V4=https://api-gw.platform.linuxfoundation.org/cla-service
USER_SERVICE=https://api-gw.platform.linuxfoundation.org/user-service/v1
LEGACY_API=https://api.easycla.lfx.linuxfoundation.org
LEGACY_V1_TOKEN_EXPECT=401
LEGACY_API_ALIAS=https://api.lfcla.com
SS_URL=https://app.lfx.dev
CORPORATE_CONSOLE=https://corporate.v1.easycla.lfx.linuxfoundation.org
CORPORATE_CONSOLE_KIND=v1
CORPORATE_FOUNDATION_SFID=
CONTRIBUTOR_CONSOLE=https://contributor.easycla.lfx.linuxfoundation.org
PCC_URL=https://projectadmin.lfx.linuxfoundation.org
PCC_V1_URL=
AUTH0_DOMAIN=sso.linuxfoundation.org
AUTH0_AUDIENCE=https://api-gw.platform.linuxfoundation.org/

# ---- AWS (read-only log scans) ---------------------------------------------
AWS_PROFILE_E2E=lfproduct-prod
LAMBDA_V4_REGION=us-east-2
LAMBDA_V4_NAME=cla-backend-go-api-v4-lambda
LAMBDA_REGION=us-east-1
LAMBDA_PREFIX=cla-backend-prod

# ---- identities (user names only; passwords in secrets/) -------------------
# ID1: roles everywhere (org admin, CLA manager of the fixture companies).
ID1=lgpm19820716
ID1_EMAIL=lgpm19820716@proton.me
ID1_UID=948d91db-c23f-11f1-82bc-520863be3ead
ID1_GITHUB=lgpm19820716
ID1_GITHUB_ID=327357744
ID1_FULLNAME=Lukasz Gryglicki
# ID2: no organization roles by default; may be CLA manager of CLA_ONLY_* only.
ID2=morgothv8
ID2_EMAIL=morgothv8@proton.me
ID2_GITHUB=morgothv8
ID2_GITHUB_ID=342847442
ID2_FIRST=Morgoth
ID2_LAST=V8

# ---- QA fixtures (writes happen ONLY here) ---------------------------------
PROJECT_SFID=a092M00001IdwOGQAZ
FOUNDATION_SFID=a092M00001IkZSNQA3
CLA_GROUP=31032d86-31c9-49dd-8478-63ffa6af47b6
CLA_GROUP_NAME=Test CLA Group
# primary fixture company: ID1 is CLA manager; approval-list / auto-ECLA / manager writes are allowed
COMPANY_ID=83f61e34-4457-45a6-a7ab-449ad6efcfbb
COMPANY_SFID=0012M00002SAW0RQAX
COMPANY_CCLA=2ee4ef73-5873-4f43-b8c1-7722f0127b2f
COMPANY_NAME=Test_NDC
# keep empty on prod: a website unknown to EasyCLA would CREATE an organization through the hardened route
COMPANY_WEBSITE=
# write fixture (fixture_writes / interactions chains): ID1 must be in this CCLA's signatureACL (not only ACS)
WRITE_PROJECT_SFID=a092M00001IdwOGQAZ
WRITE_CLA_GROUP=31032d86-31c9-49dd-8478-63ffa6af47b6
WRITE_CLA_GROUP_NAME=Test CLA Group
WRITE_COMPANY_ID=83f61e34-4457-45a6-a7ab-449ad6efcfbb
WRITE_COMPANY_SFID=0012M00002SAW0RQAX
WRITE_COMPANY_CCLA=2ee4ef73-5873-4f43-b8c1-7722f0127b2f
# real public names for the remotely validated approval-list types (added then removed by fixture_writes)
QA_GITHUB_USER=octocat
QA_GITHUB_ORG=github
QA_GITLAB_USER=gitlab-bot
QA_GITLAB_ORG=gitlab-org
WRITE_COMPANY_NAME=Test_NDC
# second fixture company (ID1 CLA manager as well): used for multi-company reads and the console checks
COMPANY2_ID=c411921e-3662-4774-8f12-6a75ac02fb60
COMPANY2_SFID=0012M00002WQimKQAT
COMPANY2_CCLA=c6a621a0-5f19-41c9-8051-bfb4c5880b3c
COMPANY2_NAME=Test account
OTHER_COMPANY_ID=
OTHER_PROJECT_SFID=
OTHER_USER_UID=
# ID1's own acknowledgements on the fixture group (used by the removal/re-add and identity checks)
ID1_ECLA=4240f2dd-11b9-455f-a50e-69cfb894b900
ID1_ICLA=ec9276d1-ce22-4b15-bd7a-1586e1de5db2
# sanctioned company (all writes must be refused with 403 company_sanctioned)
SANCTIONED_ID=9c390bfc-92c0-441d-b629-be8c811491fe
SANCTIONED_SFID=0012M00002PZzM0QAL
# organizations the identities must NOT be able to read (403)
OTHER_ORG_SFID=0014100000Te08IAAR
OTHER_ORG_NAME=Ericsson
# organizations where ID1 is an org admin (Organization lens visible); comma separated sfids
ID1_ADMIN_ORG_SFIDS=0014100000Te0yqAAB,0014100000Te2ovAAB,0012M00002WQimKQAT
# organization lens landing: company where ID2 is (or will be made) CLA manager only
