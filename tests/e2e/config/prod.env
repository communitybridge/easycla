CLA_ONLY_COMPANY_SFID=0012M00002SAW0RQAX
CLA_ONLY_COMPANY_CCLA=2ee4ef73-5873-4f43-b8c1-7722f0127b2f

# ---- M3 org-lens fixture (Organization lens -> EasyCLA -> agreement detail) ----
M3_ORG_SFID=0012M00002WQimKQAT
M3_ORG_NAME=Test account
M3_CLA_GROUP=31032d86-31c9-49dd-8478-63ffa6af47b6
M3_CCLA=c6a621a0-5f19-41c9-8051-bfb4c5880b3c
M3_PROJECT_SFID=a092M00001IdwOGQAZ
# ---- signing / GitHub fixtures: not used on prod (gates below are off) ----
ICLA_GROUP=
ICLA_GROUP_SEARCH=
ORGSIGN_GROUP=
ORGSIGN_GROUP_SEARCH=
ORGSIGN_PROJECT_SFID=
GITHUB_REPO=
GITHUB_BOT=

# ---- LaunchDarkly (flag names the SS front end evaluates; read from the browser, never written) ----
LD_FLAG_FILTER=cla|org-lens|easycla|m1|m2|m3
LD_FLAG_M3=org-lens-cla-m3-enabled
# 1 when the LD rule targets both identities (Organization lens CLA-only pages render for ID2 as well)
ID2_LD_TARGETED=1

# ---- gates -----------------------------------------------------------------
# prod: never complete DocuSign, never create companies, never open GitHub PRs
ALLOW_DOCUSIGN=0
ALLOW_COMPANY_CREATE=0
ALLOW_GITHUB_PR=0
# keep the baseline-restoring writes on (approval list / auto-ECLA / manager add+remove on the QA fixture)
ALLOW_FIXTURE_WRITES=1
# the I4B contact-manager request e-mails ID1 (own mailbox); 0 skips it
ALLOW_EMAIL=1
